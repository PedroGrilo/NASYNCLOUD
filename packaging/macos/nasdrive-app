#!/bin/sh
# Entry point of nasdrive.app. Starts nasdrive in the background and opens the
# interface; if nasdrive is already running, it only reopens the interface.
DIR=$(cd "$(dirname "$0")" && pwd)

# nasdrive links against macFUSE's libfuse. Without it the binary would not even
# start, and an app with no Dock icon would just seem to do nothing.
if [ ! -e /usr/local/lib/libfuse.2.dylib ]; then
  answer=$(osascript -e 'display alert "O nasdrive precisa do macFUSE" message "Instala o macFUSE 5.5 ou mais recente, autoriza a extensão de sistema quando o macOS pedir, reinicia o Mac e volta a abrir o nasdrive." as critical buttons {"Cancelar", "Abrir o site do macFUSE"} default button 2' 2>/dev/null)
  case "$answer" in *macFUSE*) open "https://macfuse.github.io/" ;; esac
  exit 1
fi

LOG="$HOME/Library/Logs/nasdrive.log"
mkdir -p "$(dirname "$LOG")"
if [ -f "$LOG" ] && [ "$(stat -f %z "$LOG")" -gt 5000000 ]; then mv -f "$LOG" "$LOG.old"; fi
exec "$DIR/nasdrive" ui >> "$LOG" 2>&1
